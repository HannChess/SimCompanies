generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id                  Int             @id @default(autoincrement())
  simcoResourceId     Int             @unique
  name                String
  category            String
  unitProductionCost  Float           @default(0)
  marketPrice         Float           @default(0)
  transportCost       Float           @default(0)
  stock               Float           @default(0)
  imageUrl            String?
  producedAnHour      Float?
  marketSaturation    Float?
  lastSyncedAt        DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  movements           StockMovement[]
  priceSnapshots      PriceSnapshot[]
}

model StockMovement {
  id         Int      @id @default(autoincrement())
  productId  Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type       String
  quantity   Float
  unitPrice  Float    @default(0)
  note       String?
  createdAt  DateTime @default(now())
}

model PriceSnapshot {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  price     Float
  source    String   @default("market-ticker")
  createdAt DateTime @default(now())
}

model SyncMeta {
  id           Int       @id @default(1)
  companyName  String?
  companyLevel Int?
  realm        Int       @default(0)
  lastSyncAt   DateTime?
  lastSource   String?
  notes        String?
}

model CompanyProfile {
  id                   Int       @id @default(1)
  companyId            Int?
  name                 String?
  level                Int?
  experience           Float?
  experienceToNextLevel Float?
  cash                 Float?
  companyValue         Float?
  reputation           Float?
  realm                Int?
  rawJson              String?
  lastSyncedAt         DateTime?
  source               String?
}

model GameWarehouseItem {
  id              Int      @id @default(autoincrement())
  simcoResourceId Int      @unique
  name            String
  quantity        Float    @default(0)
  quality         Int      @default(0)
  unitCost        Float?
  updatedAt       DateTime @updatedAt
}
