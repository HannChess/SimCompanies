DATABASE_URL="file:./dev.db"
PORT=3847
CORS_ORIGIN="*"
SIMCO_REALM=0
SIMCO_LANG=en
SIMCO_ECONOMY=1
# Cookie de sesión (solo GET). No la subas a git.
SIMCO_COOKIE="sessionid=TU_SESSION_ID"
SIMCO_MIN_INTERVAL_MS=300000
# 1 = usar data/simco-cache.json (recomendado si la API está bloqueada)
SIMCO_FORCE_CACHE=1
